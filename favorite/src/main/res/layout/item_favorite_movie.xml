<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/transparent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMovie"
        android:layout_width="@dimen/_136sdp"
        android:layout_height="@dimen/_225sdp"
        android:layout_marginBottom="@dimen/_14sdp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/shapeHighlightMovieCard"
        tools:layout_editor_absoluteX="46dp"
        tools:src="@drawable/ic_launcher_background" />

    <LinearLayout
        android:id="@+id/llMovieInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_14sdp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/ivMovie"
        app:layout_constraintEnd_toEndOf="@id/ivMovie"
        app:layout_constraintStart_toStartOf="@id/ivMovie">

        <TextView
            android:id="@+id/tvRelease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_movie"
            android:fontFamily="@font/poppins_regular"
            android:includeFontPadding="false"
            android:padding="@dimen/_3sdp"
            android:textColor="@color/dark_blue_app"
            android:textSize="@dimen/_9ssp"
            tools:text="Live"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:background="@drawable/bg_chip_movie"
            android:drawablePadding="@dimen/_2sdp"
            android:fontFamily="@font/poppins_regular"
            android:includeFontPadding="false"
            android:padding="@dimen/_3sdp"
            android:textColor="@color/dark_blue_app"
            android:textSize="@dimen/_9ssp"
            app:drawableStartCompat="@drawable/ic_star"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="17+" />

        <TextView
            android:id="@+id/tvAdult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:background="@drawable/bg_chip_movie"
            android:fontFamily="@font/poppins_regular"
            android:includeFontPadding="false"
            android:padding="@dimen/_3sdp"
            android:textColor="@color/dark_blue_app"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2D" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:ellipsize="end"
        android:gravity="center"
        android:fontFamily="@font/batik_sans_bold"
        android:maxLines="1"
        android:textColor="@color/dark_blue_app"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintEnd_toEndOf="@id/ivMovie"
        app:layout_constraintStart_toStartOf="@id/ivMovie"
        app:layout_constraintTop_toBottomOf="@id/ivMovie" />


</androidx.constraintlayout.widget.ConstraintLayout>