<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivTrailer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_156sdp"
        android:layout_margin="@dimen/_14sdp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/shapeHighlightMovieCard"
        tools:layout_editor_absoluteX="46dp"
        tools:src="@drawable/ic_launcher_background" />

    <ImageView
        android:id="@+id/ivPlay"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_21sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toBottomOf="@id/ivTrailer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="contentDescription" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:ellipsize="end"
        android:fontFamily="@font/batik_sans_bold"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_4sdp"
        android:maxLines="1"
        android:textColor="@color/dark_blue_app"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivTrailer"
        tools:text="Monster Hunter Outlander" />


</androidx.constraintlayout.widget.ConstraintLayout>