<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tvToolbarVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/batik_sans_bold"
        android:text="@string/label_now_playing"
        android:textColor="@color/dark_blue_app"
        android:textSize="@dimen/_22ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpVideoHighlight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_284sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/_78sdp"
        android:paddingEnd="@dimen/_78sdp"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvToolbarVideo"
        app:layout_constraintVertical_bias="0.3"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:ellipsize="end"
        android:gravity="center"
        android:fontFamily="@font/batik_sans_bold"
        android:maxLines="1"
        android:textColor="@color/dark_blue_app"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vpVideoHighlight"
        tools:text="Monster Hunter Outlander"/>

    <ProgressBar
        android:id="@+id/pbMovie"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_8sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vpVideoHighlight" />

</androidx.constraintlayout.widget.ConstraintLayout>